VITE_SUPABASE_ANON_KEY=
VITE_APP_NAME="Any Pay"

# --- Edge Functions（Supabase secrets。`supabase secrets set` または Actions「Supabase deploy」が設定） ---
# フロントの URL（プロバイダから戻る先）
APP_ORIGIN=https://any-pay.pages.dev
# チャージ API のサンドボックス（模擬プロバイダ）。未設定なら Actions が初回に自動生成する
SANDBOX_API_KEY=
SANDBOX_WEBHOOK_SECRET=
# Stripe テスト決済（任意）。設定するとカード / コンビニ / PayPay が Stripe 経由で使える
